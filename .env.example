# Copy to .env and fill in. Never commit .env.

# Database: Neon connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# psql client used to talk to Neon (Docker image sets /usr/bin/psql)
SQL50_PSQL=C:/Program Files/PostgreSQL/18/bin/psql.exe

# Neon object storage (S3-compatible) for data/ files; local data/ is the fallback
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=offline-learning-container

# AI hints: gemini (default when GEMINI_API_KEY is set) or ollama
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
